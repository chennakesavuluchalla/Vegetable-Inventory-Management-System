                        if cart_qty[i] <= quantity[veg_idx]:
                            quantity[veg_idx] -= cart_qty[i]
                        else:
                            print(f"{cart_items[i]} has only {quantity[veg_idx]} kg available.")
                            continue

                        print(f"{cart_items[i]:<15} {cart_qty[i]:<10} Rs.{cart_amount[i]}")

                        total_bill += cart_amount[i]

                        sold_items.append(cart_items[i])
                        sold_qty.append(cart_qty[i])
                        bill_amount.append(cart_amount[i])
                    print("-"*40)
                    print("                 TOTAL BILL:",total_bill)
                    print("\n")
                    print("Thank you visit again")
                    
                    cart_items.clear()
                    cart_qty.clear()
                    cart_amount.clear()
                    break
                    
            elif ch == "6": 
                break
            
            else:
                print("invalid choice")
                
    elif ch =="3":#final exit
        print("Thank you...!")
        break
    else:
        print("Invalid choice")